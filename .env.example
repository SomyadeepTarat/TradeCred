# Local development only; replace credentials before sharing an environment.
POSTGRES_USER=tradecred
POSTGRES_PASSWORD=tradecred_local
POSTGRES_DB=tradecred
DATABASE_URL=postgresql+psycopg://tradecred:tradecred_local@localhost:5432/tradecred
JWT_SECRET=local-demo-only-change-this-signing-secret
JWT_ACCESS_TOKEN_MINUTES=30
DEMO_PASSWORD=TradeCred-Demo-2026!
LEDGER_BACKEND=mock
# Mock is the explicit fallback. No automatic fallback on connection/commit failures.
DRUNIX_GATEWAY_URL=http://127.0.0.1:8080
DRUNIX_GATEWAY_TOKEN=
DRUNIX_NETWORK_ID=
DRUNIX_GATEWAY_CA_PATH=
DRUNIX_DOCKER_GATEWAY_URL=http://drunix-gateway:8080
DRUNIX_CHANNEL=
DRUNIX_CHAINCODE_NAME=tradecred
DOCUMENT_STORAGE_PATH=./data/documents
MAX_UPLOAD_BYTES=10485760
# Run make keys; copy its public-only BANK_TRUSTED_KEYS JSON for host API use.
# Docker mounts only data/bank-public, never the simulator private key.
BANK_TRUSTED_KEYS={}
PAYMENT_TIMESTAMP_TOLERANCE_SECONDS=300

# Next.js server-side API origin (Docker overrides to http://api:8000).
API_INTERNAL_URL=http://127.0.0.1:8000

# Sandbox signer; `make demo` enables this for the local demo stack only.
SIMULATOR_ENABLED=false
SIMULATOR_URL=http://127.0.0.1:8090
SIMULATOR_TOKEN=
SIMULATOR_KEY_ID=demo-bank-1
